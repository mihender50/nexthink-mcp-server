{
  "name": "nexthink-mcp-server",
  "version": "3.0.0",
  "description": "Enterprise-grade Model Context Protocol (MCP) server exposing Nexthink DEX telemetry (saved NQL API queries), Remote Actions, and engagement workflows to LLM agents. Targets MCP spec 2025-11-25 with pluggable auth for every Nexthink credential type.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihender50/nexthink-mcp-server.git"
  },
  "homepage": "https://www.npmjs.com/package/nexthink-mcp-server",
  "bugs": {
    "url": "https://github.com/mihender50/nexthink-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "nexthink-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:smoke": "npm run build && node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nexthink",
    "dex",
    "nql",
    "llm",
    "agent",
    "digital-employee-experience"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
