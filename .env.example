# Nexthink Cloud tenant base URL (no trailing slash)
NEXTHINK_INSTANCE_URL=https://your-company.nexthink.cloud

# OAuth 2.0 Client Credentials (Administration > Account Management > API Credentials)
NEXTHINK_CLIENT_ID=your-client-id
NEXTHINK_CLIENT_SECRET=your-client-secret

# Optional: comma-separated allow-list of Remote Action IDs the server may invoke.
# When set, run_remote_action rejects any action_id not present here.
# NEXTHINK_ALLOWED_ACTIONS=act:clear_temp_files,act:restart_spooler

# Optional: set to "true" to run the server in read-only mode (disables
# run_remote_action and trigger_workflow — only NQL query/export are exposed).
# NEXTHINK_READ_ONLY=false

# Optional: request timeout in milliseconds (default 30000)
# NEXTHINK_HTTP_TIMEOUT_MS=30000
