# ─── Nexthink instance targeting ────────────────────────────────────────────
# Preferred: set instance + region and the API base and OAuth token endpoint
# are derived automatically:
#   API base:  https://<instance>.api.<region>.nexthink.cloud
#   Token URL: https://<instance>-login.<region>.nexthink.cloud/oauth2/default/v1/token
NEXTHINK_INSTANCE=your-instance
NEXTHINK_REGION=eu            # one of: us | eu | pac | meta

# Overrides (on-prem / proxied / testing). If set, these win over derivation:
# NEXTHINK_API_BASE_URL=https://your-gateway.internal/nexthink
# NEXTHINK_TOKEN_URL=https://your-instance-login.eu.nexthink.cloud/oauth2/default/v1/token

# ─── Authentication (choose ONE type) ───────────────────────────────────────
# NEXTHINK_AUTH_TYPE selects how credentials are presented. Default: oauth2_basic
#   oauth2_basic  OAuth2 client-credentials, client id:secret in HTTP Basic header (OFFICIAL)
#   oauth2_post   OAuth2 client-credentials, client id/secret in the form body
#   bearer        Pre-issued/vaulted bearer token (no refresh)
#   basic         HTTP Basic username:password (legacy/on-prem classic Web API)
NEXTHINK_AUTH_TYPE=oauth2_basic

# -- oauth2_basic / oauth2_post --
NEXTHINK_CLIENT_ID=your-client-id
NEXTHINK_CLIENT_SECRET=your-client-secret
# NEXTHINK_SCOPE=service:integration     # default shown

# -- bearer --
# NEXTHINK_BEARER_TOKEN=eyJhbGciOi...

# -- basic --
# NEXTHINK_USERNAME=svc-account
# NEXTHINK_PASSWORD=super-secret

# ─── Safety guardrails ──────────────────────────────────────────────────────
# Read-only mode: only NQL query/export tools are exposed (no remote actions/workflows).
# NEXTHINK_READ_ONLY=false
# Allow-list of Remote Action ids the server may invoke (comma-separated). Empty = any.
# NEXTHINK_ALLOWED_ACTIONS=act:clear_temp_files,act:restart_spooler

# ─── Reliability / performance tuning ───────────────────────────────────────
# NEXTHINK_HTTP_TIMEOUT_MS=30000
# NEXTHINK_MAX_RETRIES=3          # retries on 429/5xx/network (honors Retry-After)
# NEXTHINK_RETRY_BASE_MS=500      # full-jitter exponential backoff base
# NEXTHINK_RETRY_MAX_MS=8000      # backoff cap
# NEXTHINK_LOG_LEVEL=info         # debug | info | warn | error  (structured JSON to stderr)

# ─── Advanced: endpoint pin ─────────────────────────────────────────────────
# NEXTHINK_NQL_EXECUTE_PATH=/api/v2/nql/execute   # pin to /api/v1/... if needed
